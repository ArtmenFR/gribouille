# Normalement généré par ./scripts/init.sh (mots de passe aléatoires).
# Pour le faire à la main : cp .env.example .env, puis remplace chaque "change-me".

# Port publié par Traefik sur la VM
HTTP_PORT=80

# Mot de passe Redis (master et replica)
REDIS_PASSWORD=change-me-redis

# Compte admin de Grafana
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Compte pour Prometheus, Alertmanager, Mailpit et le dashboard Traefik.
# Si tu crées .env à la main, génère aussi traefik/users.htpasswd :
#   printf 'admin:%s\n' "$(openssl passwd -apr1 'ton-mot-de-passe')" > traefik/users.htpasswd
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin

# Sauvegardes Redis : intervalle en secondes et nombre de copies conservées
BACKUP_INTERVAL=300
BACKUP_KEEP=12
